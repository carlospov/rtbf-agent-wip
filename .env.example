# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- LLM provider (interchangeable — see docs/specs, plugins/llm/config.py) ---
# resolve_llm_config() reads these exact names -- RTBF_LLM_*, not LLM_*.
# RTBF_LLM_PROVIDER selects a plugins/llm/registry.py preset: anthropic | openai | openrouter |
# opencode | openai-compatible (or any other name for a self-hosted/custom endpoint, e.g. "ollama").
RTBF_LLM_PROVIDER=anthropic
# Usually left unset -- inferred from the registry preset for known providers (anthropic/openai/...).
# Only needed for a fully custom provider not in the registry.
RTBF_LLM_PROTOCOL=
RTBF_LLM_MODEL=claude-sonnet-5
# Only needed for RTBF_LLM_PROVIDER=openai-compatible or another self-hosted endpoint
# (Ollama, LM Studio, vLLM, ...) not in the registry.
RTBF_LLM_BASE_URL=http://localhost:11434/v1
# Generic API key override -- prefer the provider-specific var below instead when one exists.
RTBF_LLM_API_KEY=
# Provider-specific API key vars (plugins/llm/registry.py) -- set the one matching RTBF_LLM_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=

# --- Requester identity + case defaults (rtbf_agent/config.py, R18/R22) ---
# Signs the closing line of every drafted request.
RTBF_REQUESTER_NAME=
# Default jurisdiction/drafting language for a Case that doesn't set its own (nullable per-Case
# override -- see core/models.py's Case.applicable_jurisdiction/drafting_language).
RTBF_DEFAULT_APPLICABLE_JURISDICTION=GDPR
RTBF_DEFAULT_DRAFTING_LANGUAGE=en

# --- Telegram bot (plugins/notifiers/telegram.py, resolve_telegram_config(), issue #14) ---
# Your own bot's token from @BotFather (R12/R13: never a project-operated bot) and the single
# chat_id TelegramNotifier whitelists from the very first update onward (R15) -- get yours by
# messaging your bot once and checking https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifier backend (rtbf_agent/cli.py's _resolve_notifier_backend(), issue #60) ---
# Which Notifier main_async() wires up: "console" (the default -- prompts on stdin) or
# "telegram" (drives real approval/document-receipt via the bot configured above). Unset/blank
# behaves exactly like "console".
RTBF_NOTIFIER_BACKEND=console

# --- Interface language (rtbf_agent/config.py's resolve_interface_language(), issue #14) ---
# The single interface language a whole-process caller (the Telegram bot; the kanban UI, issue #18)
# passes as `lang` on every I18nProvider.translate() call it makes -- independent of
# RTBF_DEFAULT_DRAFTING_LANGUAGE/RTBF_DEFAULT_APPLICABLE_JURISDICTION above (R22). Defaults to "en"
# if unset.
INTERFACE_LANGUAGE=en

# --- Discovery sources (optional) -- NOT YET READ BY ANY CODE (no HIBP discovery source exists yet) ---
HIBP_API_KEY=

# --- CLI entrypoint (`python -m rtbf_agent` — see rtbf_agent/cli.py, issue #36) ---
# Mailbox address the Gmail DiscoverySource scans and each resulting Case is attributed to.
RTBF_TARGET_EMAIL=
# Path to an OAuth 2.0 "installed app" client secrets JSON downloaded from Google Cloud Console
# (Gmail API enabled, readonly scope requested by build_installed_app_flow()).
RTBF_GMAIL_CLIENT_SECRETS_FILE=
# Where the CLI caches the resulting OAuth token after the first interactive login; defaults to
# ~/.config/rtbf-agent/gmail_token.json if unset.
RTBF_GMAIL_TOKEN_FILE=

# --- Reply-monitoring backend (rtbf_agent/cli.py's _resolve_reply_monitor_backend(), issue #102) ---
# Which MailboxReader follow-up monitoring uses: "gmail" (the default -- reuses the Gmail OAuth
# credentials configured above) or "imap" (a plain username/password IMAP mailbox, no OAuth app
# needed at all -- see the RTBF_IMAP_* vars below). Unset/blank behaves exactly like "gmail".
RTBF_REPLY_MONITOR_BACKEND=gmail

# --- IMAP reply reading (plugins/followup/imap_config.py, resolve_imap_config(), issue #102) ---
# Only used when RTBF_REPLY_MONITOR_BACKEND=imap above. Your own mailbox's IMAP credentials --
# TLS-only (imaplib.IMAP4_SSL), no plaintext option. All resolved as RTBF_IMAP_* (see
# plugins/followup/imap_config.py); can also live in ~/.config/rtbf-agent/config.toml under
# [imap] instead of here.
RTBF_IMAP_HOST=
RTBF_IMAP_PORT=993
RTBF_IMAP_USERNAME=
RTBF_IMAP_PASSWORD=

# --- Outbound email (SMTP) — your own account, never a project-operated relay ---
# All resolved as RTBF_SMTP_* (see plugins/senders/config.py); can also live in
# ~/.config/rtbf-agent/config.toml under [smtp] instead of here.
RTBF_SMTP_HOST=
RTBF_SMTP_PORT=587
RTBF_SMTP_USERNAME=
RTBF_SMTP_PASSWORD=
RTBF_SMTP_FROM_ADDRESS=
RTBF_SMTP_USE_TLS=true

# --- Web search (plugins/websearch/searxng.py, resolve_searxng_config(), issue #65) ---
# A SearXNG instance's JSON search API (https://docs.searxng.org/dev/search_api.html) -- point
# this at your own self-hosted instance (a single Docker container), never a project-operated
# search relay (R12/R13). Must have `search: formats: [json]` enabled; most public instances
# disable this, so a self-hosted instance is expected, not a fallback. Can also live in
# ~/.config/rtbf-agent/config.toml under [websearch] instead of here.
RTBF_SEARXNG_BASE_URL=http://localhost:8080
# Only needed if your instance sits behind a reverse proxy expecting a bearer token -- most
# self-hosted instances need no key at all.
RTBF_SEARXNG_API_KEY=

# --- Local storage ---
DATABASE_URL=sqlite:///./data/rtbf-agent.db

# --- Sensitive document storage (rtbf_agent/document_store.py, issue #17) ---
# Fernet key for encrypting uploaded identity documents at rest. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RTBF_DOCUMENT_ENCRYPTION_KEY=
# Where encrypted document files live; defaults to ~/.local/share/rtbf-agent/documents if unset.
RTBF_DOCUMENT_STORAGE_DIR=
